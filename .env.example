# LINE Bot
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# LLM
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key
LLM_MODEL=gemini/gemini-2.5-flash

# Database
# Local dev: sqlite+aiosqlite:///data/fitness.db
# Production (Supabase Session Pooler, IPv4):
#   postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///data/fitness.db

# Storage
# local    -> data/images/, served via /images/{key}/{token}
# supabase -> Supabase Storage bucket, signed URLs minted by Supabase
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fitness-images

# App
ALLOWED_USER_IDS=comma_separated_line_user_ids
TIMEZONE=Asia/Taipei
BASE_URL=
ADMIN_API_KEY=
# LINE user id of the operator (admin). Receives notifications when admin
# operations such as /admin/import-history finish. Required for that endpoint.
ADMIN_LINE_USER_ID=
