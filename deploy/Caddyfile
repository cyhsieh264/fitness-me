# Caddy auto-HTTPS reverse proxy. DOMAIN is loaded from .env at start.
# Caddy obtains and renews a Let's Encrypt certificate automatically — as long
# as the public DNS for {$DOMAIN} resolves to this host and 80/443 are reachable.

{$DOMAIN} {
    reverse_proxy app:8000

    # Reasonable defaults for a single-tenant LINE bot:
    # - Drop large bodies that aren't ours (images go to Supabase, not us)
    request_body {
        max_size 10MB
    }

    encode zstd gzip

    # Access log at INFO during early deployment so we can see request
    # patterns / latencies. Tighten to WARN once the deploy is stable.
    log {
        output stderr
        level INFO
    }
}
